---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/cmch-logo.png';
import Button from '@/components/ui/Button.astro';
import { NAV, SITE } from '@/config/site';
import { getContacto } from '@/lib/content';

const { waHref } = await getContacto();
---

<header class="sticky top-0 z-50 border-b border-line bg-ink/92 backdrop-blur-[10px]">
  <div class="container-site flex h-17 items-center justify-between gap-5">
    <a
      href="#inicio"
      aria-label={`${SITE.name}, ir al inicio`}
      class="flex min-h-11 items-center gap-3 text-white no-underline hover:text-white"
    >
      <Image
        src={logo}
        alt=""
        width={44}
        height={44}
        densities={[1, 2]}
        loading="eager"
        class="block size-11 rounded-full"
      />
      <span class="font-display text-[19px] font-bold tracking-[0.08em]">{SITE.name}</span>
    </a>

    <nav aria-label="Secciones" class="hidden items-center gap-1 lg:flex">
      {NAV.map((item) => (
        <a
          href={item.href}
          class="flex min-h-11 items-center px-4 font-condensed text-[17px] font-semibold tracking-[0.08em] text-muted uppercase no-underline transition-colors hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <Button href={waHref} size="sm" icon="whatsapp" aria-label="Pedir por WhatsApp">
      <span class="sm:hidden">Pedir</span>
      <span class="hidden sm:inline">Pedir por WhatsApp</span>
    </Button>
  </div>
</header>
