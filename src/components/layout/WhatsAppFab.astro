---
import Icon from '@/components/ui/Icon.astro';
import { getContacto } from '@/lib/content';

const { waHref } = await getContacto();
---

<!-- En celular se oculta mientras la grilla del catálogo está a la vista (cada tarjeta ya tiene su botón). -->
<a
  href={waHref}
  target="_blank"
  rel="noopener"
  aria-label="Pedir por WhatsApp"
  data-fab
  class="chamfer-12 fixed right-4 bottom-4 z-60 flex size-14.5 items-center justify-center bg-brand text-white transition-[opacity,transform,background-color] duration-250 ease-out hover:bg-brand-light hover:text-white max-sm:data-hidden:pointer-events-none max-sm:data-hidden:translate-y-4 max-sm:data-hidden:opacity-0"
>
  <Icon name="whatsapp" size={28} />
</a>

<script>
  const fab = document.querySelector<HTMLElement>('[data-fab]');
  const grid = document.getElementById('catalogo-grid');

  if (fab && grid && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      fab.toggleAttribute('data-hidden', Boolean(entry?.isIntersecting));
    }).observe(grid);
  }
</script>
