---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  id: string;
  nombre: string;
  fotos: ImageMetadata[];
}

const { id, nombre, fotos } = Astro.props;
const total = fotos.length;
const navButton =
  'chamfer-8 absolute top-1/2 flex size-12 -translate-y-1/2 items-center justify-center bg-ink/85 text-white transition-colors hover:bg-brand disabled:pointer-events-none disabled:opacity-0';
---

<dialog
  id={id}
  data-lightbox
  aria-label={`Fotos: ${nombre}`}
  class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink/95 p-0 text-white backdrop:bg-ink/80"
>
  <div class="flex h-full flex-col">
    <div class="container-site flex w-full items-center justify-between gap-4 py-3">
      <p class="truncate font-display text-lg font-bold tracking-[0.03em] uppercase">{nombre}</p>
      <div class="flex shrink-0 items-center gap-3">
        {total > 1 && (
          <span data-lightbox-counter class="font-condensed text-lg font-semibold text-muted">
            1 / {total}
          </span>
        )}
        <button
          type="button"
          data-lightbox-close
          aria-label="Cerrar"
          class="chamfer-8 flex size-12 items-center justify-center bg-surface-2 text-white transition-colors hover:bg-brand"
        >
          <Icon name="x" size={24} strokeWidth={2} />
        </button>
      </div>
    </div>

    <div class="relative min-h-0 flex-1">
      <ul
        data-lightbox-track
        class="flex h-full snap-x snap-mandatory overflow-x-auto overscroll-x-contain scrollbar-none [&::-webkit-scrollbar]:hidden"
      >
        {fotos.map((foto, i) => (
          <li
            data-lightbox-slide
            class="flex h-full w-full shrink-0 snap-center items-center justify-center px-4 pb-6"
          >
            <Image
              src={foto}
              alt={`${nombre}, foto ${i + 1} de ${total}`}
              widths={[800, 1200, 1600]}
              sizes="(min-width: 1296px) 1200px, 100vw"
              loading="lazy"
              class="max-h-full w-auto max-w-full bg-white object-contain"
            />
          </li>
        ))}
      </ul>

      {total > 1 && (
        <>
          <button
            type="button"
            data-lightbox-prev
            aria-label="Foto anterior"
            class:list={[navButton, 'left-2 sm:left-4']}
          >
            <Icon name="chevron-left" size={28} strokeWidth={2} />
          </button>
          <button
            type="button"
            data-lightbox-next
            aria-label="Foto siguiente"
            class:list={[navButton, 'right-2 sm:right-4']}
          >
            <Icon name="chevron-right" size={28} strokeWidth={2} />
          </button>
        </>
      )}
    </div>
  </div>
</dialog>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setupLightbox(dialog: HTMLDialogElement): void {
    const track = dialog.querySelector<HTMLElement>('[data-lightbox-track]');
    if (!track) return;
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]');
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const total = track.children.length;

    const current = () => Math.round(track.scrollLeft / (track.clientWidth || 1));
    // Foto destino mientras dura el scroll animado: evita que dos clics rápidos lean una posición intermedia.
    let target: number | null = null;

    const update = () => {
      if (target !== null && Math.abs(track.scrollLeft - target * track.clientWidth) < 2)
        target = null;
      const index = target ?? current();
      if (counter) counter.textContent = `${index + 1} / ${total}`;
      if (prev) prev.disabled = index <= 0;
      if (next) next.disabled = index >= total - 1;
    };

    const go = (delta: number) => {
      target = Math.min(Math.max((target ?? current()) + delta, 0), total - 1);
      track.scrollTo({
        left: target * track.clientWidth,
        behavior: reduceMotion.matches ? 'instant' : 'smooth',
      });
      update();
    };

    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('scrollend', () => {
      target = null;
      update();
    });
    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

    // Click fuera de la foto (fondo del diálogo o del slide) cierra.
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.hasAttribute('data-lightbox-slide')) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') go(-1);
      if (event.key === 'ArrowRight') go(1);
    });

    // Al abrir: volver a la primera foto. El foco regresa solo al trigger al cerrar (nativo).
    document
      .querySelectorAll<HTMLButtonElement>(`[data-lightbox-open="${dialog.id}"]`)
      .forEach((trigger) => {
        trigger.addEventListener('click', () => {
          dialog.showModal();
          target = null;
          track.scrollLeft = 0;
          update();
        });
      });
  }

  document.querySelectorAll<HTMLDialogElement>('dialog[data-lightbox]').forEach(setupLightbox);
</script>
