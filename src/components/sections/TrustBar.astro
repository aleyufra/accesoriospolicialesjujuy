---
import Icon from '@/components/ui/Icon.astro';
import { trustItems } from '@/data/landing';
---

<section aria-label="Condiciones de compra" class="border-b border-line bg-surface-2">
  <!-- Mismo contenedor que el resto de las secciones; en celular las filas van de borde a borde. -->
  <div class="container-site max-sm:px-0">
    <!--
      Celular: una fila por ítem.
      Tablet (sm): 3 columnas iguales, ícono arriba y texto centrado.
      Escritorio (lg): space-between de borde a borde del contenedor, con un divisor
      (elemento propio) que queda en el medio de cada hueco.
    -->
    <ul class="flex flex-col divide-y divide-line sm:flex-row sm:divide-x sm:divide-y-0 lg:justify-between lg:divide-x-0">
      {trustItems.map((item, i) => (
        <>
          {i > 0 && <li aria-hidden="true" class="hidden w-px self-stretch bg-line lg:block" />}
          <li class="flex items-center gap-3 px-4 py-4 sm:flex-1 sm:flex-col sm:px-5 sm:py-6 sm:text-center lg:flex-none lg:flex-row lg:px-0 lg:text-left">
            <Icon name={item.icon} size={26} class="text-brand-light" />
            <span class="text-[17px] leading-[1.35] font-medium text-balance text-white">
              {item.text}
            </span>
          </li>
        </>
      ))}
    </ul>
  </div>
</section>
