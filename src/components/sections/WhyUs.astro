---
import ChamferBox from '@/components/ui/ChamferBox.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { beneficios, extras } from '@/data/landing';
---

<section aria-labelledby="porque-titulo" class="bg-ink py-[clamp(64px,9vw,120px)]">
  <div class="container-site">
    <SectionHeading id="porque-titulo" title="Por qué C.M.C.H" />

    <ul
      data-reveal
      class="mt-[clamp(40px,4vw,56px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-x-8"
    >
      {beneficios.map((item) => (
        <li class="flex flex-col gap-3.5 border-t border-line py-7">
          <ChamferBox
            size={8}
            aria-hidden="true"
            class="size-12 bg-brand"
            innerClass="items-center justify-center bg-ink"
          >
            <Icon name={item.icon} size={22} class="text-brand-light" />
          </ChamferBox>
          <h3 class="font-display text-xl leading-[1.2] font-bold tracking-[0.03em] text-white uppercase">
            {item.titulo}
          </h3>
          <p class="text-[17px] leading-normal text-pretty text-muted">{item.texto}</p>
        </li>
      ))}
    </ul>

    <div data-reveal class="mt-[clamp(48px,5vw,72px)]">
      <div class="flex items-center gap-4">
        <p class="font-condensed text-lg font-semibold tracking-[0.12em] whitespace-nowrap text-brand-light uppercase">
          Incluido sin costo
        </p>
        <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
      </div>

      <div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-[clamp(16px,2vw,24px)]">
        {extras.map((item) => (
          <ChamferBox
            size={16}
            class="bg-brand"
            innerClass="flex-col gap-3.5 bg-surface-2 bg-noise p-[clamp(24px,3vw,36px)]"
          >
            <Icon name={item.icon} size={32} strokeWidth={1.5} class="text-brand-light" />
            <h3 class="mt-1 font-display text-[clamp(20px,1.8vw,24px)] leading-[1.2] font-bold tracking-[0.03em] text-white uppercase">
              {item.titulo}
            </h3>
            <p class="text-lg leading-normal text-pretty text-muted">{item.texto}</p>
          </ChamferBox>
        ))}
      </div>
    </div>
  </div>
</section>
